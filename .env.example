# CyberLab Company Production Environment Template
# Copy to .env or run ./deploy/deploy-company.sh to auto-generate strong secrets

ENVIRONMENT=production

# REQUIRED in production: 64-char hex secret (generate via: openssl rand -hex 32)
SECRET_KEY=CHANGE_ME_TO_64_CHAR_RANDOM_HEX_SECRET

# Pre-shared enrollment key required for endpoint agents to register
AGENT_ENROLLMENT_KEY=CHANGE_ME_ENROLLMENT_KEY

# PostgreSQL Credentials
POSTGRES_USER=cyberlab
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=cyberlab_db

# Built-in Non-Privileged Syslog/NDR Receiver (UDP/TCP)
SYSLOG_ENABLED=true
SYSLOG_PORT=5514

# Network Driver: "simulation" (default safe) or "kernel" (requires CAP_NET_ADMIN)
NETWORK_ENGINE_DRIVER=simulation

# Frontend public API endpoint (use /api/backend when behind Nginx HTTPS proxy, or http://SERVER_IP:8000/api/v1)
NEXT_PUBLIC_API_URL=/api/backend
